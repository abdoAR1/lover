-- ==========================================
-- AURA HUB V17 - PINK EDITION (Keyless)
-- ==========================================
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")

-- ==========================================
-- MAIN HUB FUNCTION
-- ==========================================
local function LoadMainHub()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local VirtualInputManager = game:GetService("VirtualInputManager")

    local KnitServices = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services")
    local ChallengeRemote = KnitServices:WaitForChild("ChallengeService"):WaitForChild("RF"):WaitForChild("ClaimReward")
    local SeasonRemote = KnitServices:WaitForChild("SeasonService"):WaitForChild("RF"):WaitForChild("RequestRankedReward")

    local autoTokens, autoStyle, autoYen, autoAbility = false, false, false, false
    local autoAfk = false
    local timeRemaining = -1
    local tokenX = -1

    local validStyleIds = {11, 7, 1}
    local validYenIds = {10, 2}
    local validAbilityIds = {8, 4}
    local styleIndex, yenIndex, abilityIndex = 1, 1, 1

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "AuraHubUI_Pink"
    local successUI = pcall(function() if gethui then ScreenGui.Parent = gethui() else ScreenGui.Parent = CoreGui end end)
    if not successUI then ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "AuraHub_Main"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(255, 192, 203) -- Soft Pink
    MainFrame.BackgroundTransparency = 0.05
    MainFrame.Position = UDim2.new(0.5, -140, 0.5, -170)
    MainFrame.Size = UDim2.new(0, 280, 0, 40) 
    MainFrame.ClipsDescendants = true 
    MainFrame.Active = true
    MainFrame.Draggable = true 
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 15)

    local UIStroke = Instance.new("UIStroke", MainFrame)
    UIStroke.Color = Color3.fromRGB(255, 255, 255); UIStroke.Thickness = 3; UIStroke.Transparency = 0.2

    local Title = Instance.new("TextLabel", MainFrame)
    Title.BackgroundTransparency = 1; Title.Position = UDim2.new(0, 15, 0, 0); Title.Size = UDim2.new(0, 200, 0, 40)
    Title.Font = Enum.Font.FredokaOne; Title.Text = "🌸 AURA HUB 🌸"; Title.TextColor3 = Color3.fromRGB(255, 255, 255); Title.TextSize = 18; Title.TextXAlignment = Enum.TextXAlignment.Left

    local DestroyBtn = Instance.new("TextButton", MainFrame)
    DestroyBtn.BackgroundColor3 = Color3.fromRGB(255, 105, 180); DestroyBtn.Position = UDim2.new(1, -75, 0, 8); DestroyBtn.Size = UDim2.new(0, 24, 0, 24)
    DestroyBtn.Font = Enum.Font.GothamBold; DestroyBtn.Text = "X"; DestroyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", DestroyBtn).CornerRadius = UDim.new(1, 0)

    local MinimizeBtn = Instance.new("TextButton", MainFrame)
    MinimizeBtn.BackgroundTransparency = 1; MinimizeBtn.Position = UDim2.new(1, -40, 0, 5); MinimizeBtn.Size = UDim2.new(0, 30, 0, 30)
    MinimizeBtn.Font = Enum.Font.GothamBold; MinimizeBtn.Text = "-"; MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255); MinimizeBtn.TextSize = 24

    local TabBar = Instance.new("Frame", MainFrame)
    TabBar.BackgroundTransparency = 1; TabBar.Position = UDim2.new(0, 10, 0, 40); TabBar.Size = UDim2.new(1, -20, 0, 30)

    local function createTabBtn(name, pos)
        local btn = Instance.new("TextButton", TabBar)
        btn.BackgroundColor3 = Color3.fromRGB(255, 182, 193); btn.Position = pos; btn.Size = UDim2.new(0.33, -2, 1, 0)
        btn.Font = Enum.Font.FredokaOne; btn.Text = name; btn.TextColor3 = Color3.fromRGB(255, 255, 255); btn.TextSize = 12
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        return btn
    end

    local TabMainBtn = createTabBtn("Main", UDim2.new(0, 0, 0, 0))
    local TabSpinsBtn = createTabBtn("Spins", UDim2.new(0.33, 2, 0, 0))
    local TabAfkBtn = createTabBtn("AFK", UDim2.new(0.66, 4, 0, 0))
    TabMainBtn.BackgroundColor3 = Color3.fromRGB(255, 105, 180) -- Hot Pink for active

    local PageMain = Instance.new("Frame", MainFrame)
    PageMain.BackgroundTransparency = 1; PageMain.Position = UDim2.new(0, 0, 0, 75); PageMain.Size = UDim2.new(1, 0, 1, -75)
    local PageSpins = Instance.new("Frame", MainFrame)
    PageSpins.BackgroundTransparency = 1; PageSpins.Position = UDim2.new(0, 0, 0, 75); PageSpins.Size = UDim2.new(1, 0, 1, -75); PageSpins.Visible = false 
    local PageAfk = Instance.new("Frame", MainFrame)
    PageAfk.BackgroundTransparency = 1; PageAfk.Position = UDim2.new(0, 0, 0, 75); PageAfk.Size = UDim2.new(1, 0, 1, -75); PageAfk.Visible = false 

    -- MAIN PAGE CONTENT
    local TokensBtn = Instance.new("TextButton", PageMain)
    TokensBtn.BackgroundColor3 = Color3.fromRGB(255, 240, 245); TokensBtn.Position = UDim2.new(0, 15, 0, 10); TokensBtn.Size = UDim2.new(0, 250, 0, 35)
    TokensBtn.Font = Enum.Font.FredokaOne; TokensBtn.Text = "Claim Tokens: OFF"; TokensBtn.TextColor3 = Color3.fromRGB(255, 105, 180); TokensBtn.TextSize = 13
    Instance.new("UICorner", TokensBtn).CornerRadius = UDim.new(0, 10)

    local InfoLabel = Instance.new("TextLabel", PageMain)
    InfoLabel.BackgroundTransparency = 1; InfoLabel.Position = UDim2.new(0, 15, 0, 55); InfoLabel.Size = UDim2.new(0, 250, 0, 40)
    InfoLabel.Font = Enum.Font.GothamMedium; InfoLabel.Text = "Safe Version: No auto-rollers to keep your items safe! ✨"; InfoLabel.TextColor3 = Color3.fromRGB(255, 255, 255); InfoLabel.TextSize = 11; InfoLabel.TextWrapped = true

    local DiscordBox = Instance.new("TextBox", PageMain)
    DiscordBox.BackgroundColor3 = Color3.fromRGB(255, 182, 193); DiscordBox.Position = UDim2.new(0, 15, 0, 105); DiscordBox.Size = UDim2.new(0, 250, 0, 30)
    DiscordBox.Font = Enum.Font.FredokaOne; DiscordBox.Text = "discord.gg/WRCa2VNhem"; DiscordBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    DiscordBox.TextSize = 11; DiscordBox.ClearTextOnFocus = false; DiscordBox.TextEditable = false 
    Instance.new("UICorner", DiscordBox).CornerRadius = UDim.new(0, 8)

    -- SPINS PAGE CONTENT
    local function createSmartRow(yPos, btnText, startID)
        local label = Instance.new("TextLabel", PageSpins)
        label.BackgroundColor3 = Color3.fromRGB(255, 240, 245); label.Position = UDim2.new(0, 15, 0, yPos); label.Size = UDim2.new(0, 75, 0, 35)
        label.Font = Enum.Font.FredokaOne; label.Text = "ID: " .. startID; label.TextColor3 = Color3.fromRGB(255, 105, 180); label.TextSize = 12
        Instance.new("UICorner", label).CornerRadius = UDim.new(0, 8)

        local btn = Instance.new("TextButton", PageSpins)
        btn.BackgroundColor3 = Color3.fromRGB(255, 182, 193); btn.Position = UDim2.new(0, 100, 0, yPos); btn.Size = UDim2.new(0, 165, 0, 35)
        btn.Font = Enum.Font.FredokaOne; btn.Text = btnText .. ": OFF"; btn.TextColor3 = Color3.fromRGB(255, 255, 255); btn.TextSize = 12
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        return label, btn
    end

    local StyleLabel, StyleBtn = createSmartRow(10, "Style Spins", validStyleIds[1])
    local YenLabel, YenBtn = createSmartRow(55, "Claim Yen", validYenIds[1])
    local AbilityLabel, AbilityBtn = createSmartRow(100, "Ability Spins", validAbilityIds[1])

    -- AFK PAGE CONTENT
    local AfkBtn = Instance.new("TextButton", PageAfk)
    AfkBtn.BackgroundColor3 = Color3.fromRGB(255, 240, 245); AfkBtn.Position = UDim2.new(0, 15, 0, 10); AfkBtn.Size = UDim2.new(0, 250, 0, 35)
    AfkBtn.Font = Enum.Font.FredokaOne; AfkBtn.Text = "Anti-AFK: OFF"; AfkBtn.TextColor3 = Color3.fromRGB(255, 105, 180); AfkBtn.TextSize = 13
    Instance.new("UICorner", AfkBtn).CornerRadius = UDim.new(0, 10)

    -- LOGIC & ANIMATIONS
    local isMinimized = false
    local fullHeight = 300 

    local function tweenColor(object, targetColor, targetTextColor)
        TweenService:Create(object, TweenInfo.new(0.3), {BackgroundColor3 = targetColor, TextColor3 = targetTextColor}):Play()
    end

    TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(0, 280, 0, fullHeight)}):Play()

    DestroyBtn.MouseButton1Click:Connect(function()
        autoTokens, autoStyle, autoYen, autoAbility, autoAfk = false, false, false, false, false
        if ScreenGui then ScreenGui:Destroy() end
    end)

    MinimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        local targetHeight = isMinimized and 40 or fullHeight
        MinimizeBtn.Text = isMinimized and "+" or "-"
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(0, 280, 0, targetHeight)}):Play()
    end)

    local function switchTab(activeBtn, activePage)
        tweenColor(TabMainBtn, Color3.fromRGB(255, 182, 193), Color3.fromRGB(255, 255, 255))
        tweenColor(TabSpinsBtn, Color3.fromRGB(255, 182, 193), Color3.fromRGB(255, 255, 255))
        tweenColor(TabAfkBtn, Color3.fromRGB(255, 182, 193), Color3.fromRGB(255, 255, 255))
        tweenColor(activeBtn, Color3.fromRGB(255, 105, 180), Color3.fromRGB(255, 255, 255))
        PageMain.Visible, PageSpins.Visible, PageAfk.Visible = false, false, false
        activePage.Visible = true
    end

    TabMainBtn.MouseButton1Click:Connect(function() switchTab(TabMainBtn, PageMain) end)
    TabSpinsBtn.MouseButton1Click:Connect(function() switchTab(TabSpinsBtn, PageSpins) end)
    TabAfkBtn.MouseButton1Click:Connect(function() switchTab(TabAfkBtn, PageAfk) end)

    local function handleToggle(btn, stateVar, name)
        local state = not stateVar
        if state then
            btn.Text = name .. ": ON"
            tweenColor(btn, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 20, 147))
        else
            btn.Text = name .. ": OFF"
            tweenColor(btn, Color3.fromRGB(255, 240, 245), Color3.fromRGB(255, 105, 180))
        end
        return state
    end

    TokensBtn.MouseButton1Click:Connect(function() autoTokens = handleToggle(TokensBtn, autoTokens, "Claim Tokens") end)
    StyleBtn.MouseButton1Click:Connect(function() autoStyle = handleToggle(StyleBtn, autoStyle, "Style Spins") end)
    YenBtn.MouseButton1Click:Connect(function() autoYen = handleToggle(YenBtn, autoYen, "Claim Yen") end)
    AbilityBtn.MouseButton1Click:Connect(function() autoAbility = handleToggle(AbilityBtn, autoAbility, "Ability Spins") end)

    -- Functionality Loops (Simplified)
    task.spawn(function()
        while task.wait(1) do
            if autoStyle then pcall(function() SeasonRemote:InvokeServer(validStyleIds[styleIndex]) end) end
            if autoYen then pcall(function() SeasonRemote:InvokeServer(validYenIds[yenIndex]) end) end
            if autoAbility then pcall(function() SeasonRemote:InvokeServer(validAbilityIds[abilityIndex]) end) end
        end
    end)

    task.spawn(function()
        while task.wait(0.2) do
            if autoTokens then
                tokenX = tokenX - 1
                pcall(function() ChallengeRemote:InvokeServer(tokenX) end)
            end
        end
    end)

    AfkBtn.MouseButton1Click:Connect(function()
        autoAfk = handleToggle(AfkBtn, autoAfk, "Anti-AFK")
        if autoAfk then
            task.spawn(function()
                while autoAfk do
                    pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game); task.wait(0.1); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
                    task.wait(math.random(120, 300))
                end
            end)
        end
    end)
end

-- Jump straight to the hub!
LoadMainHub()
